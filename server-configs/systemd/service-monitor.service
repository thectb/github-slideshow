[Unit]
Description=Service Monitor and Auto-Restart
After=network.target nginx.service php8.3-fpm.service mariadb.service

[Service]
Type=simple
ExecStart=/usr/local/bin/service-monitor.sh
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
